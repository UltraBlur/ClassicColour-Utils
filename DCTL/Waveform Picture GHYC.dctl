// ============================================================================
//  Waveform Picture  (波形图 · 藏在示波器里的画面)
//  by GHYC
//
//  原理 (How it works)
//  -------------------
//  波形监视器显示的是: 对图像每一列 x, 该列中亮度值 ≈ h 的像素个数
//  D(x, h) = count{ y : L(x, y) ≈ h }。
//
//  本 DCTL 让输出图像的列 x 满足:
//      count{ 值 ≈ h_j }  ∝  原画面在 (x, 第 j 行) 的亮度
//  于是波形监视器(Luma)上就会看到: 亮处点密、暗处点疏 —— 也就是原始画面本身,
//  像一张点阵密度图, 而且方向是正的。
//
//  实现: 对每个输出像素, 沿本列采样 bins 个等距行位置得到亮度剖面 w[j],
//  取其累积分布 CDF; 把像素映射为 [0,1) 的采样位置 u, 反查逆 CDF 得到剖面
//  位置 pos, 再换算成信号电平输出(灰度)。
//
//  ★ 稳定顺排 (Waterfall) ★
//  u 取像素的行位置 u = (y + 0.5) / H (自上而下), 故同一列内输出电平随行严格
//  单调 —— 示波器上每一电平对应一行, 呈现为清晰的"瀑布"条纹, 隐藏画面最锐利,
//  且逐帧稳定、无噪点、无摩尔纹。不引入任何伪随机数。
//
//  观看方法: 在 Resolve 中把本节点挂到素材上, 打开示波器,
//  选择 WAVEFORM + LUMA, 即可看到被"藏"起来的原画面。
//
//  注意: 直接看输出图像本身是灰度瀑布条纹, 请务必配合示波器观看。
// ============================================================================

// clang-format off
DEFINE_UI_PARAMS(bins,     Histogram Bins,       DCTLUI_SLIDER_INT, 128, 16, 256, 16)
DEFINE_UI_PARAMS(rowsub,   Row Samples,          DCTLUI_SLIDER_INT, 2, 1, 4, 1)
DEFINE_UI_PARAMS(gamma,    Dot Contrast,         DCTLUI_SLIDER_FLOAT, 1.8, 0.2, 3.0, 0.05)
DEFINE_UI_PARAMS(exposure, Exposure,             DCTLUI_SLIDER_FLOAT, 1.0, 0.1, 3.0, 0.05)
DEFINE_UI_PARAMS(outgamma, Output Gamma,         DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 2.5, 0.05)
DEFINE_UI_PARAMS(mix,      Reveal Original,      DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(invert,   Invert Picture,       DCTLUI_SLIDER_INT, 0, 0, 1, 1)
DEFINE_UI_PARAMS(flipy,    Flip Vertical,        DCTLUI_SLIDER_INT, 0, 0, 1, 1)
DEFINE_UI_PARAMS(flipx,    Flip Horizontal,      DCTLUI_SLIDER_INT, 0, 0, 1, 1)
DEFINE_UI_PARAMS(grid,     Scope Graticule,      DCTLUI_SLIDER_INT, 0, 0, 1, 1)
// clang-format on

__DEVICE__ float3 get_color(int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB) {
    float r = _tex2D(p_TexR, p_X, p_Y);
    float g = _tex2D(p_TexG, p_X, p_Y);
    float b = _tex2D(p_TexB, p_X, p_Y);
    return make_float3(r, g, b);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB) {
    // 采样列号(支持水平镜像, 隐藏画面可以镜像)
    int sx = (flipx == 1) ? (p_Width - 1 - p_X) : p_X;

    // ---- Pass 1: 采样本列亮度剖面 w[j], j=0 对应画面最上一行 ----
    // 每个 bin 内做 rowsub 次盒式平均, 抑制细密横向条纹的混叠
    float prof[256];  // 滑块上限 256, 与数组尺寸一致
    float total = 0.0f;
    float binh = (float)p_Height / (float)bins;
    for (int j = 0; j < bins; ++j) {
        float acc = 0.0f;
        for (int s = 0; s < rowsub; ++s) {
            int sy = (int)(((float)j + ((float)s + 0.5f) / (float)rowsub) * binh);
            if (sy > p_Height - 1) sy = p_Height - 1;
            if (sy < 0) sy = 0;
            float3 c = get_color(sx, sy, p_TexR, p_TexG, p_TexB);
            acc += 0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z;  // Rec.709 luma
        }
        float w = _fminf(1.0f, _fmaxf(0.0f, acc / (float)rowsub) * exposure);
        w = _powf(w, gamma);
        if (invert == 1) w = 1.0f - w;
        prof[j] = w;
        total += w;
    }

    // ---- 采样位置 u ∈ [0,1): 行位置(自上而下) => 顺排/瀑布 ----
    // 同一列内严格单调, 示波器上每个电平对应一行, 隐藏画面最锐利且逐帧稳定。
    float u = ((float)p_Y + 0.5f) / (float)p_Height;

    // ---- Pass 2: 逆 CDF, 在剖面内取位置 pos ∈ [0,1) ----
    float pos;
    if (total > 1e-6f) {
        float target = u * total;
        float acc = 0.0f;
        float prev = 0.0f;
        pos = 1.0f;
        for (int j = 0; j < bins; ++j) {
            prev = acc;
            acc += prof[j];
            if (acc >= target) {
                float frac = 0.0f;
                if (acc > prev) frac = (target - prev) / (acc - prev);
                pos = ((float)j + frac) / (float)bins;
                break;
            }
        }
    } else {
        // 整列剖面为零(全黑或反相后全黑): 均匀铺满, 避免示波器上出现一根亮线
        pos = u;
    }

    // ---- 行位置 → 信号电平。电平 1.0(顶部)对应画面最上一行 => 画面正立 ----
    float level = (flipy == 1) ? pos : (1.0f - pos);
    level = _fmaxf(0.0f, _fminf(1.0f, level));
    float val = _powf(level, outgamma);

    // ---- 灰度输出; Reveal 渐变回原图(混合后示波器上画面逐渐融化) ----
    float3 rgb = make_float3(val, val, val);
    if (mix > 0.0f) {
        float3 src = get_color(p_X, p_Y, p_TexR, p_TexG, p_TexB);
        rgb.x = mix * src.x + (1.0f - mix) * rgb.x;
        rgb.y = mix * src.y + (1.0f - mix) * rgb.y;
        rgb.z = mix * src.z + (1.0f - mix) * rgb.z;
    }

    // ---- 仿示波器刻度线(可选; 会作为信号输出, 因此示波器上也会出现) ----
    if (grid == 1) {
        float gy = ((float)p_Y + 0.5f) / (float)p_Height;
        float gx = ((float)p_X + 0.5f) / (float)p_Width;
        float dy = _fabs(gy * 4.0f - _round(gy * 4.0f)) / 4.0f * (float)p_Height;
        float dx = _fabs(gx * 10.0f - _round(gx * 10.0f)) / 10.0f * (float)p_Width;
        if (dy < 0.8f || dx < 0.8f) {
            rgb = make_float3(0.10f, 0.10f, 0.10f);
        }
    }

    return rgb;
}
